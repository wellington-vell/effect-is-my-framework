{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**"]
    },
    "clean": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "cache": false,
      "persistent": true
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "db-gen": {
      "cache": false
    },
    "db-migrate": {
      "cache": false
    },
    "db-push": {
      "cache": false
    },
    "db-check": {
      "cache": false
    },
    "db-studio": {
      "cache": false,
      "persistent": true
    }
  },
  "boundaries": {
    "tags": {}
  }
}
