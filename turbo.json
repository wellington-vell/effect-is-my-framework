{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**"]
    },
    "clean": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "cache": false,
      "persistent": true
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "db-gen": {
      "cache": false
    },
    "db-migrate": {
      "cache": false
    },
    "db-push": {
      "cache": false
    },
    "db-check": {
      "cache": false
    },
    "db-studio": {
      "cache": false,
      "persistent": true
    },
    "seed": {
      "cache": false
    }
  },
  "boundaries": {
    "tags": {
      "shared": {
        "dependencies": {
          "deny": [
            "contracts",
            "domain",
            "core",
            "db",
            "env",
            "auth",
            "web",
            "server"
          ]
        }
      },
      "contracts": {
        "dependencies": {
          "deny": ["domain", "core", "db", "env", "auth", "web", "server"]
        }
      },
      "domain": {
        "dependencies": {
          "deny": ["contracts", "core", "auth", "web", "server"]
        }
      },
      "core": {
        "dependencies": {
          "deny": ["web", "server"]
        }
      },
      "db": {
        "dependencies": {
          "deny": [
            "contracts",
            "domain",
            "core",
            "shared",
            "auth",
            "web",
            "server"
          ]
        }
      },
      "env": {
        "dependencies": {
          "deny": [
            "contracts",
            "domain",
            "core",
            "db",
            "shared",
            "auth",
            "web",
            "server"
          ]
        }
      },
      "auth": {
        "dependencies": {
          "deny": ["contracts", "domain", "core", "web", "server"]
        }
      },
      "web": {
        "dependencies": {
          "deny": ["domain", "core", "db", "server"]
        }
      },
      "server": {
        "dependencies": {
          "deny": ["web"]
        }
      }
    }
  }
}
