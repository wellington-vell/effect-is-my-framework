{
  "name": "effect-framework",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@effect/platform-node": "^4.0.0-beta.106",
      "@types/node": "^22.15.0",
      "effect": "^4.0.0-beta.106",
      "typescript": "7.0.2",
      "tsdown": "0.22.4"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "clean": "turbo clean",
    "check": "oxlint --type-aware --type-check apps/ packages/ && oxfmt --write .",
    "prepare": "effect-tsgo patch --typescript --oxlint"
  },
  "dependencies": {
    "effect": "catalog:"
  },
  "devDependencies": {
    "@effect/language-service": "^0.87.2",
    "@effect/tsgo": "0.36.1",
    "@types/bun": "latest",
    "oxfmt": "^0.61.0",
    "oxlint": "1.77.0",
    "oxlint-tsgolint": "7.0.2001",
    "turbo": "^2.10.9",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "typescript": "catalog:"
  },
  "engines": {
    "bun": ">=1.3.10",
    "npm": "this-project-uses-bun",
    "pnpm": "this-project-uses-bun",
    "yarn": "this-project-uses-bun"
  },
  "packageManager": "bun@1.3.10"
}
