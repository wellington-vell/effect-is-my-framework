{
  "name": "acme",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@effect/atom-react": "^4.0.0-beta.107",
      "@effect/platform-node": "^4.0.0-beta.107",
      "@effect/sql-pg": "4.0.0-beta.107",
      "@types/node": "22.15.0",
      "drizzle-kit": "1.0.0-rc.4",
      "drizzle-orm": "1.0.0-rc.4",
      "effect": "^4.0.0-beta.107",
      "typescript": "7.0.2",
      "tsdown": "0.22.4",
      "vitest": "4.1.10",
      "@effect/vitest": "^4.0.0-beta.107"
    }
  },
  "type": "module",
  "scripts": {
    "boundaries": "turbo boundaries",
    "build": "turbo build",
    "check": "oxlint --type-aware --type-check apps/ packages/ && oxfmt --write .",
    "clean": "turbo clean",
    "clean-root": "rm -rf node_modules .turbo",
    "db-check": "turbo -F @acme/db db-check",
    "db-gen": "turbo -F @acme/db db-gen --",
    "db-migrate": "turbo -F @acme/db db-migrate",
    "db-push": "turbo -F @acme/db db-push",
    "db-studio": "turbo -F @acme/db db-studio",
    "dev": "turbo dev",
    "dev-server": "turbo -F @acme/server dev",
    "docker-build": "DOCKER_BUILDKIT=1 docker compose build --progress=plain && docker compose up -d",
    "docker-clean": "docker compose down -v && docker system prune --all && docker system prune --volumes",
    "docker-dev": "docker compose -f docker-compose.dev.yml up -d",
    "docker-dev:reset": "docker compose -f docker-compose.dev.yml down -v && docker compose -f docker-compose.dev.yml up -d",
    "docker-down": "docker compose down -v",
    "fallow": "fallow -c fallow.toml",
    "fallow:ci": "fallow -c fallow.toml --ci",
    "prepare": "effect-tsgo patch --typescript --oxlint",
    "sync": "bun update --interactive --recursive --latest",
    "test": "turbo test"
  },
  "devDependencies": {
    "@effect/language-service": "0.87.2",
    "@effect/tsgo": "0.36.1",
    "@types/bun": "1.3.10",
    "drizzle-kit": "catalog:",
    "fallow": "3.14.0",
    "oxfmt": "0.61.0",
    "oxlint": "1.77.0",
    "oxlint-tsgolint": "7.0.2001",
    "turbo": "2.10.9",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "typescript": "catalog:"
  },
  "engines": {
    "bun": ">=1.3.10",
    "npm": "this-project-uses-bun",
    "pnpm": "this-project-uses-bun",
    "yarn": "this-project-uses-bun"
  },
  "packageManager": "bun@1.3.10",
  "patchedDependencies": {
    "drizzle-orm@1.0.0-rc.4": "patches/drizzle-orm@1.0.0-rc.4.patch"
  }
}
